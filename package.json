{
  "name": "syncspace",
  "private": true,
  "type": "module",
  "workspaces": [
    "client",
    "server"
  ],
  "scripts": {
    "build": "npm run build --workspace client",
    "preview": "npm run preview --workspace client",
    "lint": "npm run lint --workspace client && npm run lint --workspace server",
    "dev": "concurrently -k -n server,client -c blue,magenta \"npm:dev:server\" \"npm:dev:client\"",
    "dev:memory": "concurrently -k -n server,client -c blue,magenta \"npm:dev:server:memory\" \"npm:dev:client\"",
    "dev:client": "npm run dev --workspace client",
    "dev:server": "npm run dev --workspace server",
    "dev:server:memory": "npm run dev:memory --workspace server",
    "test": "npm run test --workspace server",
    "test:e2e": "playwright test"
  },
  "engines": {
    "node": ">=20"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "concurrently": "^10.0.5"
  }
}
