# Origin of the backend HTTP server (Express + Hocuspocus + Socket.io).
# Leave these unset in development to use the Vite proxy in vite.config.js.
VITE_BACKEND_ORIGIN=http://localhost:4000

# Absolute overrides. Useful in production where the API is on another host.
# VITE_API_URL=https://api.syncspace.example
# VITE_COLLAB_URL=wss://api.syncspace.example/collab
# VITE_SOCKET_URL=https://api.syncspace.example
