NODE_ENV=development
PORT=4000
HOST=0.0.0.0

MONGODB_URI=mongodb://127.0.0.1:27017/syncspace

# Required in production, 32+ characters. A development fallback is used when unset.
# JWT_SECRET=replace-me-with-a-long-random-string
JWT_EXPIRES_IN=7d

# Comma-separated list.
CORS_ORIGIN=http://localhost:5173
LOG_LEVEL=info

# Guests may open public rooms without an account. Must be false in production.
ALLOW_ANONYMOUS=true

# Append-only Yjs update log. Required by the replay endpoints.
PERSIST_UPDATE_LOG=true
PERSIST_DEBOUNCE_MS=2000
PERSIST_MAX_DEBOUNCE_MS=10000

RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=300

# Credential endpoints share this window but each has its own budget.
AUTH_RATE_LIMIT_WINDOW_MS=900000
AUTH_RATE_LIMIT_REGISTER_MAX=5
AUTH_RATE_LIMIT_LOGIN_MAX=10
AUTH_RATE_LIMIT_PASSWORD_CHANGE_MAX=10

# Room invites grant access, so they are capped separately.
INVITE_RATE_LIMIT_MAX=30
